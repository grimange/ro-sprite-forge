            {
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "evidence"
      ],
      "type": "object"
