            "default_interval_ms",
            "walk_interval_ms",
            "pickup_interval_ms",
            "attack_hurt_frame",
            "player_idle",
            "nonloop_end",
            "completion_check",
            "looping",
            "nonlooping"
          ],
          "type": "object"
        }
      ]
