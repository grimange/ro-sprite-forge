          "type": "object"
        },
        "order": {
          "items": {
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "relationships": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "child": {
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
