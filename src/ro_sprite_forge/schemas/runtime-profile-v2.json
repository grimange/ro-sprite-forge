    "profile_version": {
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,5}\\.[0-9]{1,6}\\.[0-9]{1,6}(?![\\s\\S])",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "delay_slot": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "requested_slot": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "resolved_slot": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "unmapped_action": {
              "maxLength": 1024,
              "minLength": 1,
