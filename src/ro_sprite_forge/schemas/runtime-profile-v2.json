{
  "$id": "https://ro-sprite-forge.invalid/schemas/runtime-profile-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "group": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "maximum": 511,
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
                "type": "string"
              }
            ]
          },
          "mapping": {
            "enum": [
              "SUPPORTED",
              "UNSUPPORTED",
              "UNVERIFIED"
            ]
          },
          "reachability": {
            "enum": [
              "SUPPORTED",
              "UNSUPPORTED",
              "UNVERIFIED"
            ]
          },
          "slots": {
            "items": {
              "maximum": 4095,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 8,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "group",
          "slots",
          "mapping",
          "reachability",
          "evidence"
        ],
        "type": "object"
      },
      "maxItems": 512,
      "minItems": 0,
      "type": "array"
    },
    "canonical_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "category": {
      "enum": [
        "player",
        "npc",
        "monster",
        "unverified"
      ]
    },
    "id": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
      "type": "string"
    },
    "legacy_profile_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        }
      ]
    },
    "parts": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "additionalProperties": false,
          "properties": {
            "declarations": {
