              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "looping": {
              "items": {
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "nonloop_end": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "nonlooping": {
              "items": {
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "pickup_interval_ms": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "player_idle": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "walk_interval_ms": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
