                "additionalProperties": false,
                "properties": {
                  "evidence": {
                    "items": {
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                      "type": "string"
                    },
                    "maxItems": 64,
                    "minItems": 0,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "id": {
                    "maxLength": 80,
                    "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
                    "type": "string"
