              "status": {
                "enum": [
                  "SUPPORTED",
                  "UNSUPPORTED",
                  "UNVERIFIED"
                ]
              }
            },
            "required": [
              "parent",
              "child",
              "rule",
              "status",
              "evidence"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array"
