    "schema": {
      "const": "rsf.animation-inspection/v1"
    },
    "semantics": {
      "type": "object",
      "properties": {
        "renderer": {
          "const": "1.1.0"
        },
        "geometry": {
          "const": "1.0.0"
        },
        "timing": {
          "const": "1.0.0"
        },
        "coordinates": {
          "type": "string"
        }
      },
      "required": [
        "renderer",
        "geometry",
        "timing",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "body_act": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body_spr": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "head_act": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "head_spr": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
