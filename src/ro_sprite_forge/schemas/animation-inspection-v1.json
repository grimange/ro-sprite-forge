        "requested_slot": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_slot": {
          "type": "integer",
          "minimum": 0
        },
        "view": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "direction": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            {
              "type": "null"
            }
          ]
        },
        "camera_direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_delay": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
