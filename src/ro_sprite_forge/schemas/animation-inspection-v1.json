      "additionalProperties": false,
      "dependentRequired": {
        "head_act": [
          "head_spr"
        ],
        "head_spr": [
          "head_act"
        ]
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "rsf.timeline-selection/v1"
        },
        "timing_version": {
          "const": "1.0.0"
        },
        "act_document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "category": {
          "enum": [
            "player",
            "npc",
            "monster",
            "unverified"
          ]
