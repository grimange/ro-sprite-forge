        "schema",
        "timing_version",
        "act_document_sha256",
        "profile_sha256",
        "category",
        "action",
        "requested_slot",
        "resolved_slot",
        "view",
        "direction",
        "camera_direction",
        "frame",
        "frame_count",
        "source_delay",
        "mode",
        "timing_status",
        "timing_rule",
        "elapsed_ms",
        "speed",
        "context",
        "frame_time",
        "frame_duration_ms",
        "looping",
        "terminal_hold",
        "native_completion",
        "fallback",
        "reachability",
        "diagnostics",
        "canonical_sha256"
