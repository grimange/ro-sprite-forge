        "mode": {
          "enum": [
            "MANUAL",
            "TIMED"
          ]
        },
        "timing_status": {
          "enum": [
            "NOT_EVALUATED",
            "SUPPORTED",
            "UNVERIFIED",
            "DIAGNOSTIC"
          ]
        },
        "timing_rule": {
          "anyOf": [
            {
              "enum": [
                "EXPLICIT_DIAGNOSTIC_INTERVAL",
                "EXTERNAL_DURATION_U32",
                "ACT_DELAY_F32",
                "PLAYER_IDLE_FRAME_ZERO"
