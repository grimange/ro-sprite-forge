{
  "$id": "https://ro-sprite-forge.invalid/schemas/actor-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_profile": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
      "type": "string"
    },
    "canonical_sha256": {
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "category": {
      "enum": [
        "player",
        "npc",
        "monster",
        "unverified"
      ]
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "declarations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "evidence": {
                "items": {
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                  "type": "string"
                },
                "maxItems": 64,
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
                "type": "string"
              },
              "status": {
                "enum": [
                  "SUPPORTED",
                  "UNSUPPORTED",
                  "UNVERIFIED"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "evidence"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "minItems": 0,
          "type": "array"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNVERIFIED"
          ]
        }
      },
      "required": [
        "status",
        "declarations"
      ],
      "type": "object"
    },
    "gameplay_job": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
          "type": "string"
        }
      ]
    },
    "id": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
      "type": "string"
    },
    "parts": {
      "items": {
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        }
      ]
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "act_sha256": {
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "type": "string"
          },
          "inventory_sha256": {
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "type": "string"
          },
          "part": {
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
            "type": "string"
          },
          "spr_sha256": {
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "part",
          "inventory_sha256",
          "act_sha256",
          "spr_sha256"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "runtime_profile": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "type": "string"
        },
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 20,
          "pattern": "^[1-9][0-9]{0,5}\\.[0-9]{1,6}\\.[0-9]{1,6}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "id",
        "profile_version",
        "canonical_sha256"
      ],
      "type": "object"
    },
    "schema": {
      "const": "rsf.actor/v1"
    },
    "visual": {
      "additionalProperties": false,
      "properties": {
        "body_family": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
          "type": "string"
        },
        "body_variant": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "costume": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "sex": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_.-]{1,80}(?![\\s\\S])",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "body_family",
        "sex",
        "body_variant",
        "costume"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "previous_sha256",
    "category",
    "gameplay_job",
    "visual",
    "parts",
    "runtime_profile",
    "action_profile",
    "compatibility",
    "resources"
  ],
  "type": "object"
}
